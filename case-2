<!DOCTYPE html>
<html>
<head>
    <title>Study Academic Dashboard</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background-color: #f4f6fb;
            display: flex;
        }

        /* Sidebar */
        .sidebar {
            width: 230px;
            height: 100vh;
            background-color: #243b55;
            color: white;
            padding: 25px 20px;
        }

        .sidebar h2 {
            margin-bottom: 35px;
            text-align: center;
        }

        .sidebar a {
            display: block;
            color: white;
            text-decoration: none;
            padding: 14px;
            margin-bottom: 10px;
            border-radius: 6px;
        }

        .sidebar a:hover {
            background-color: #456789;
        }

        /* Main content */
        .main {
            flex: 1;
            padding: 30px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .header h1 {
            color: #243b55;
        }

        .header p {
            color: #777;
            margin-top: 8px;
        }

        /* Welcome section */
        .welcome {
            background-color: #dce8f7;
            padding: 25px;
            border-radius: 12px;
            margin-bottom: 25px;
        }

        .welcome h2 {
            color: #243b55;
            margin-bottom: 10px;
        }

        /* Cards */
        .cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .card {
            background-color: white;
            padding: 22px;
            border-radius: 10px;
            box-shadow: 0 2px 8px #ddd;
        }

        .card h3 {
            color: #555;
            margin-bottom: 12px;
        }

        .card h2 {
            color: #243b55;
            font-size: 28px;
        }

        /* Content sections */
        .content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .section {
            background-color: white;
            padding: 22px;
            border-radius: 10px;
            box-shadow: 0 2px 8px #ddd;
        }

        .section h2 {
            color: #243b55;
            margin-bottom: 20px;
        }

        .subject {
            margin-bottom: 18px;
        }

        .subject p {
            margin-bottom: 8px;
        }

        .progress {
            height: 10px;
            background-color: #eee;
            border-radius: 10px;
        }

        .progress-bar {
            height: 10px;
            background-color: #4a90e2;
            border-radius: 10px;
        }

        /* Assignments */
        .assignment {
            padding: 12px;
            background-color: #f4f6fb;
            margin-bottom: 12px;
            border-radius: 7px;
        }

        .assignment p {
            margin-top: 5px;
            color: #777;
        }

        /* Timetable */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 25px;
            background-color: white;
        }

        th, td {
            padding: 14px;
            text-align: center;
            border: 1px solid #ddd;
        }

        th {
            background-color: #243b55;
            color: white;
        }

        /* Responsive design */
        @media (max-width: 800px) {
            body {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
                height: auto;
            }

            .sidebar a {
                display: inline-block;
            }

            .cards {
                grid-template-columns: 1fr;
            }

            .content {
                grid-template-columns: 1fr;
            }

            .main {
                padding: 15px;
            }
        }
    </style>
</head>

<body>

    <!-- Sidebar -->
    <div class="sidebar">
        <h2>My Study</h2>

        <a href="#">Dashboard</a>
        <a href="#">My Subjects</a>
        <a href="#">Assignments</a>
        <a href="#">Timetable</a>
        <a href="#">Study Progress</a>
        <a href="#">Settings</a>
    </div>

    <!-- Main Dashboard -->
    <div class="main">

        <div class="header">
            <div>
                <h1>Academic Dashboard</h1>
                <p>Welcome back! Keep learning and achieve your goals.</p>
            </div>
            <h3>Student</h3>
        </div>

        <!-- Welcome -->
        <div class="welcome">
            <h2>Hello, Student!</h2>
            <p>Welcome to your personal study dashboard.
               Manage your subjects, assignments and daily activities here.</p>
        </div>

        <!-- Summary Cards -->
        <div class="cards">

            <div class="card">
                <h3>Total Subjects</h3>
                <h2>6</h2>
            </div>

            <div class="card">
                <h3>Completed Assignments</h3>
                <h2>12</h2>
            </div>

            <div class="card">
                <h3>Study Hours</h3>
                <h2>25 Hrs</h2>
            </div>

        </div>

        <!-- Subjects and Assignments -->
        <div class="content">

            <div class="section">
                <h2>My Subjects</h2>

                <div class="subject">
                    <p>Python Programming - 80%</p>
                    <div class="progress">
                        <div class="progress-bar"
                             style="width:80%"></div>
                    </div>
                </div>

                <div class="subject">
                    <p>Mathematics - 65%</p>
                    <div class="progress">
                        <div class="progress-bar"
                             style="width:65%"></div>
                    </div>
                </div>

                <div class="subject">
                    <p>Computer Science - 90%</p>
                    <div class="progress">
                        <div class="progress-bar"
                             style="width:90%"></div>
                    </div>
                </div>

                <div class="subject">
                    <p>English - 70%</p>
                    <div class="progress">
                        <div class="progress-bar"
                             style="width:70%"></div>
                    </div>
                </div>

            </div>

            <div class="section">
                <h2>Upcoming Assignments</h2>

                <div class="assignment">
                    <h3>Python Programming</h3>
                    <p>Submit Date: 08 November</p>
                </div>

                <div class="assignment">
                    <h3>Mathematics</h3>
                    <p>Submit Date: 10 November</p>
                </div>

                <div class="assignment">
                    <h3>Computer Science</h3>
                    <p>Submit Date: 12 November</p>
                </div>

            </div>

        </div>

        <!-- Weekly Timetable -->
        <div class="section" style="margin-top:25px;">

            <h2>Weekly Study Timetable</h2>

            <table>
                <tr>
                    <th>Day</th>
                    <th>9 AM</th>
                    <th>11 AM</th>
                    <th>2 PM</th>
                </tr>

                <tr>
                    <td>Monday</td>
                    <td>Python</td>
                    <td>Maths</td>
                    <td>English</td>
                </tr>

                <tr>
                    <td>Tuesday</td>
                    <td>Science</td>
                    <td>Python</td>
                    <td>Maths</td>
                </tr>

                <tr>
                    <td>Wednesday</td>
                    <td>English</td>
                    <td>Science</td>
                    <td>Python</td>
                </tr>

                <tr>
                    <td>Thursday</td>
                    <td>Maths</td>
                    <td>English</td>
                    <td>Science</td>
                </tr>

                <tr>
                    <td>Friday</td>
                    <td>Python</td>
                    <td>Maths</td>
                    <td>Revision</td>
                </tr>

            </table>

        </div>

    </div>

</body>
</html>
